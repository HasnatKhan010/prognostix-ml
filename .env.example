# Environment overrides. Copy to `.env` and adjust; nothing here is required -
# every value has a working default in configs/config.yaml.
#
#   cp .env.example .env

# --- configuration ---
# Alternative config file (absolute or relative to the project root).
PROGNOSTIX_CONFIG=configs/config.yaml

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins allowed to call the API. Narrow this in production.
API_CORS_ORIGINS=*

# --- inference ---
# Model served when a request does not name one: gru | lstm | attention | random_forest | linear
DEFAULT_MODEL=gru

# --- monitoring ---
# POST alerts to this URL as well as logging them (Slack, PagerDuty, etc.).
ALERT_WEBHOOK_URL=

# --- training ---
# auto picks CUDA when available, otherwise CPU.
DEVICE=auto
LOG_LEVEL=INFO
