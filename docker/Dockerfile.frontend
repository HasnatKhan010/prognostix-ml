# Dashboard image - static files behind nginx, no build step.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.frontend -t prognostix-frontend .

FROM nginx:1.27-alpine

# Replace the default site with our config (static files + API reverse proxy).
RUN rm /etc/nginx/conf.d/default.conf
COPY frontend/nginx.conf /etc/nginx/conf.d/prognostix.conf

COPY frontend/index.html frontend/styles.css frontend/app.js /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=4s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
